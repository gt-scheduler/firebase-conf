rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /schedules/{userId}/{documents=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId
    }

    match /course_critique_course_data_cache/{document=**} {
      allow read, write: if false;
    }

    match /friends/{userId}/{documents=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId
    }

    match /metrics/{document} {
      allow read: if true;
      
      allow write: if request.auth != null && resource != null && request.auth.uid == resource.data.author;
      
      allow create: if request.auth != null && request.auth.uid == request.resource.data.author;
    }
  }
}
